# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=write_orders,read_orders,read_customers,write_customers,read_fulfillments,write_fulfillments

# ─── Database (Postgres — Supabase / Neon / Railway) ──────────────────────────
# DATABASE_URL: connection-pooled URL (PgBouncer or Prisma Accelerate)
DATABASE_URL=postgresql://user:pass@host:6543/zeroleak?pgbouncer=true&connection_limit=1
# DIRECT_URL: direct (non-pooled) for Prisma migrations
DIRECT_URL=postgresql://user:pass@host:5432/zeroleak

# ─── Upstash QStash (replaces BullMQ/Redis) ───────────────────────────────────
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
META_PHONE_ID=1069714842897407
META_BUSINESS_ID=4482293865335341
META_WEBHOOK_VERIFY_TOKEN=ZL_webhook_secret_9xK4vP7mR2QyW8cL
# Do NOT commit the real token value — set in Vercel dashboard
META_ACCESS_TOKEN=

# ─── Google Gemini (NL rule parser) ──────────────────────────────────────────
GEMINI_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=
NODE_ENV=production
