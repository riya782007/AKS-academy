# ─── Shopify ─────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-domain.fly.dev
SCOPES=write_orders,read_orders,write_products,read_products,read_customers,write_customers,read_fulfillments,write_fulfillments

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://zeroleak:password@localhost:5432/zeroleak_production

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Twilio (WhatsApp Business) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Google Maps (Geocoding + Address Validation) ─────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Meta CAPI (Conversion Events) ───────────────────────────────────────────
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=

# ─── Anthropic (Rule Parser AI Layer) ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── App Config ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SESSION_SECRET=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AUTOPILOT=true
ENABLE_WHATSAPP_VERIFY=true
ENABLE_NL_RULES=true
RISK_ENGINE_VERSION=v1
