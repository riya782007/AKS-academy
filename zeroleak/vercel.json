{
        "buildCommand": "npx prisma generate && npm run build",
        "installCommand": "npm install",
        "regions": ["iad1"],
        "env": {
                  "NODE_ENV": "production"
        },
        "headers": [
                  {
                              "source": "/api/(.*)",
                              "headers": [
                                            { "key": "Cache-Control", "value": "no-store" }
                              ]
                  }
        ]
}
