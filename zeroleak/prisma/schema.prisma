generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL used only in production for Prisma Accelerate / pgBouncer.
  // Uncomment when deploying to Vercel:
  // directUrl = env("DIRECT_URL")
}

// ─── Shopify OAuth Session ────────────────────────────────────────────────────
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// ─── Merchant ─────────────────────────────────────────────────────────────────
model Merchant {
  id                  String    @id @default(cuid())
  shop                String    @unique
  name                String?
  email               String?

  // Billing
  plan                String    @default("FREE")   // FREE | GROWTH | PRO
  planActivatedAt     DateTime?
  verificationsUsed   Int       @default(0)
  billingCycleStart   DateTime?

  // Autopilot
  autopilotEnabled    Boolean   @default(false)

  // WhatsApp / Meta
  metaPhoneId         String?
  metaAccessToken     String?   // per-merchant override; falls back to env

  // Razorpay (Pro only, per-merchant keys)
  razorpayKeyId       String?
  razorpayKeySecret   String?
  tokenAdvanceAmount  Int       @default(99)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders        Order[]
  rules         Rule[]
  verifications Verification[]
  pincodes      MerchantPincode[]
  profitLedger  ProfitLedgerEntry[]

  @@index([shop])
}

// ─── Order ────────────────────────────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  shopifyOrderId  String
  shopifyOrderGid String
  merchantId      String
  orderNumber     String
  totalPrice      Decimal     @db.Decimal(10, 2)
  currency        String      @default("INR")
  customerPhone   String?
  customerEmail   String?
  customerId      String?
  shippingPincode String?
  shippingCity    String?
  shippingState   String?
  paymentMethod   String      // COD | PREPAID | UPI | CARD
  riskScore       Int?
  riskBand        RiskBand?
  decision        Decision?
  decisionReason  String?
  decisionAt      DateTime?
  status          OrderStatus @default(PENDING)
  isRTO           Boolean     @default(false)
  rtoReportedAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  riskFactors   RiskFactor[]
  verifications Verification[]

  @@unique([merchantId, shopifyOrderId])
  @@index([merchantId, createdAt])
  @@index([merchantId, riskBand])
  @@index([shippingPincode])
  @@index([customerId])
}

// ─── Risk Factor breakdown ────────────────────────────────────────────────────
model RiskFactor {
  id        String   @id @default(cuid())
  orderId   String
  factor    String
  score     Int
  detail    String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ─── WhatsApp / Token Verification ───────────────────────────────────────────
model Verification {
  id              String             @id @default(cuid())
  orderId         String
  merchantId      String
  type            VerificationType
  channel         String             @default("WHATSAPP")
  phone           String
  waMessageId     String?
  paymentLink     String?
  status          VerificationStatus @default(PENDING)
  sentAt          DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime
  attempts        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([orderId])
  @@index([merchantId, status])
  @@index([phone])
}

// ─── Merchant Rules ───────────────────────────────────────────────────────────
model Rule {
  id            String    @id @default(cuid())
  merchantId    String
  name          String
  naturalText   String?
  type          RuleType
  priority      Int       @default(50)
  isActive      Boolean   @default(true)
  conditions    Json
  action        Json
  appliedCount  Int       @default(0)
  lastAppliedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, isActive])
}

// ─── Merchant Pincode Risk (uploaded from CSV) ────────────────────────────────
model MerchantPincode {
  id            String   @id @default(cuid())
  merchantId    String
  pincode       String
  city          String?
  state         String?
  totalOrders   Int      @default(0)
  rtoCount      Int      @default(0)
  rtoPercentage Float    @default(0)  // 0.0–100.0
  riskBand      RiskBand @default(GREEN)
  updatedAt     DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, pincode])
  @@index([merchantId])
  @@index([pincode])
}

// ─── Daily Profit Ledger ──────────────────────────────────────────────────────
model ProfitLedgerEntry {
  id            String   @id @default(cuid())
  merchantId    String
  date          DateTime @db.Date
  ordersTotal   Int      @default(0)
  shippedCount  Int      @default(0)
  verifiedCount Int      @default(0)
  heldCount     Int      @default(0)
  rtoPrevented  Int      @default(0)
  profitSaved   Decimal  @db.Decimal(10, 2) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, date])
  @@index([merchantId, date])
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum RiskBand {
  GREEN
  AMBER
  RED
}

enum Decision {
  SHIP
  VERIFY
  HOLD
}

enum OrderStatus {
  PENDING
  PROCESSED
  VERIFIED
  SHIPPED
  CANCELLED
  RTO
}

enum VerificationType {
  WHATSAPP
  TOKEN_ADVANCE
}

enum VerificationStatus {
  PENDING
  SENT
  CONFIRMED
  REJECTED
  EXPIRED
  FAILED
}

enum RuleType {
  AUTO
  MANUAL
  NL_PARSED
}
